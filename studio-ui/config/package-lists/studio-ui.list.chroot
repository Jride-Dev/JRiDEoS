# JRiDEoS Studio-UI — VST-heavy DAW + gaming packages for GWTN141-10
# live-build: installed into target chroot. No recommends (see studio-ui/auto/config).
# Native third-party stack is installed by hooks AFTER this list:
#   0210 -> WineHQ winehq-staging + :i386 ANV/Vulkan multilib
#   0220 -> pinned Yabridge (system-wide) + pinned GE-Proton (system template)
# Only 100% Debian-repo packages are listed here so base install never breaks
# on third-party downtime.

# --- live + base ---
live-boot
live-config
live-config-systemd
systemd
systemd-resolved
systemd-timesyncd
dbus
sudo
vim-tiny
less
ca-certificates
curl
wget
cabextract
unzip
p7zip-full

# --- PREEMPT_RT kernel / microcode / firmware (Tiger Lake-UP3) ---
linux-image-rt-amd64
intel-microcode
firmware-linux
firmware-misc-nonfree
firmware-iwlwifi
firmware-sof-signed
firmware-realtek
rtirq-init
rtkit

# --- Iris Xe graphics: Mesa ANV Vulkan + iHD VA-API ---
mesa-vulkan-drivers
mesa-va-drivers
mesa-vdpau-drivers
intel-media-va-driver
libvulkan1
libva2
libva-drm2
libvdpau1
vainfo
intel-gpu-tools
vulkan-tools

# --- platform: power / thermal / nvme ---
thermald
power-profiles-daemon
powertop
nvme-cli
linux-cpupower
acpi
acpid

# --- pro-audio: PipeWire full JACK replacement + ALSA/MIDI tools ---
alsa-ucm-conf
alsa-utils
alsa-tools
pipewire
pipewire-jack
pipewire-alsa
pipewire-pulse
wireplumber
qpwgraph
pavucontrol-qt

# --- creation suite (native Debian packages; REAPER via install script) ---
ardour
audacity
obs-studio
calf-plugins
lsp-plugins
x42-plugins

# --- gaming shell (Wine-Staging + GE-Proton land in hooks) ---
steam-installer
gamescope
gamemode
mangohud
winetricks

# --- net: Intel AC9461/AX201 (iwlwifi) + Realtek fallback + BT ---
network-manager
wpasupplicant
wireless-tools
iw
bluetooth
bluez

# --- desktop: KDE Plasma Wayland (fractional scaling for 14.1" FHD) ---
kde-plasma-desktop
sddm
konsole
dolphin
kate
plasma-nm
plasma-pa
powerdevil
adwaita-icon-theme

# --- browser + security baseline ---
firefox-esr
apparmor
apparmor-profiles
apparmor-utils
ufw
fail2ban
unattended-upgrades
