#!/bin/sh
# JRiDEoS Studio-UI live-build config — Gateway GWTN141-10
# VST-heavy DAW + gaming spin: KDE Plasma Wayland, PREEMPT_RT,
# native Wine-Staging (WineHQ), Yabridge, GE-Proton baked in.
# Run from studio-ui/ dir via: ./build.sh (inside Debian container / Codespace)
set -e

lb config noauto \
  --mode debian \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --linux-flavours rt-amd64 \
  --debian-installer live \
  --debian-installer-distribution trixie \
  --bootloaders "syslinux grub-efi" \
  --uefi-secure-boot enable \
  --iso-application "JRiDEoS-Studio-UI" \
  --iso-preparer "Jride-Dev" \
  --iso-volume "JRIDEOS-STUDIO-UI 1.0" \
  --iso-publisher "JRiDEoS" \
  --image-name "jrideos-studio-ui-1.0-amd64" \
  --apt-recommends false \
  --apt-indices false \
  --memtest none \
  --win32-loader false \
  --firmware-binary true \
  --firmware-chroot true \
  --bootappend-live "threadirqs preempt=full intel_pstate=active i915.enable_guc=3" \
  "${@}"
